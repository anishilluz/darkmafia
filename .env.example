# DARK MAFIA CUSTOMS — HEADLESS HOSTINGER CONFIGURATION
# Next.js Frontend -> Hostinger WordPress + WooCommerce Engine

# URL of your WordPress installation on Hostinger (e.g. cms.darkmafiacustoms.com)
NEXT_PUBLIC_WORDPRESS_URL=https://cms.darkmafiacustoms.com

# WooCommerce REST API Credentials (Generated in WP Admin -> WooCommerce -> Settings -> Advanced -> REST API)
# Read/Write permissions are required for product synchronization and order placement.
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Revalidation Webhook Secret (Matches the secret in your WordPress webhook trigger)
REVALIDATION_SECRET=dmc_super_secure_revalidation_secret_2026

# Public Site Domain
NEXT_PUBLIC_SITE_URL=https://www.darkmafiacustoms.com
